# Copy this file to ".env" in the project root and fill in your own key.
# Never commit .env.
#
# The Chaos AI uses a local stub by default (no network, no cost).
# Set CHAOS_USE_LLM=1 and a valid GPTSAPI_API_KEY to use the GPTsAPI relay.
# Each chaos phase is one billed chat request (plus at most one repair request
# if the model returns invalid JSON).

CHAOS_USE_LLM=0

# GPTsAPI relay (OpenAI-compatible chat completions)
# Tested base URL; include /v1 at most once.
GPTSAPI_BASE_URL=https://api2.gptsapi.net/v1
GPTSAPI_API_KEY=sk-your-key-here
# Exact model id from `python scripts/debug_llm.py models`
GPTSAPI_MODEL=gpt-6-luna

# Optional
# GPTSAPI_TIMEOUT=45
# GPTSAPI_MAX_TOKENS=256
# GPTSAPI_USER_AGENT=Mozilla/5.0 ...   (a browser UA is sent by default; Python's default UA got Cloudflare 1010)
